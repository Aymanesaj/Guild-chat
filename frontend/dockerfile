# ---------- Build Stage ----------
FROM node:24-alpine AS builder

WORKDIR /app

COPY app/package*.json ./
RUN npm ci

COPY app/ .
RUN npm run build


# ---------- Runtime Stage ----------
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]