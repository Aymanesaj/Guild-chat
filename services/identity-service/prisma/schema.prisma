generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GITHUB
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  username        String       @unique(map: "uk_users_username") @db.VarChar(32)
  email           String       @unique(map: "uk_users_email")
  passwordHash    String?      @map("password_hash") @db.VarChar(100)
  displayName     String       @map("display_name") @db.VarChar(80)
  bio             String?      @db.VarChar(280)
  avatarUrl       String?      @map("avatar_url")
  authProvider    AuthProvider @default(LOCAL) @map("auth_provider")
  oauthProviderId String?      @map("oauth_provider_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([authProvider, oauthProviderId], map: "uk_users_oauth")
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at")
  revoked    Boolean  @default(false)
  replacedBy String?  @map("replaced_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_refresh_tokens_user")
  @@index([tokenHash], map: "idx_refresh_tokens_hash")
  @@map("refresh_tokens")
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([requesterId, addresseeId], map: "uk_friendships_pair")
  @@index([requesterId], map: "idx_friendships_requester")
  @@index([addresseeId], map: "idx_friendships_addressee")
  @@map("friendships")
}
