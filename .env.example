# -----------------------------------------------------------
# --------------------- grafana env ----------------------
# -----------------------------------------------------------

GF_SERVER_ROOT_URL=http://localhost/grafana/
GF_SECURITY_ADMIN_USER=something
GF_SECURITY_ADMIN_PASSWORD=something
GF_USERS_ALLOW_SIGN_UP=false
GF_PLUGINS_CHECK_FOR_UPDATES=false
# Enable Anonymous Access
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_NAME=Main Org.
# Set role: 'Admin' gives full UI control, 'Editor' lets you edit panels, 'Viewer' is read-only
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Optional: Hide the login button/form completely from the UI
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_SECURITY_ALLOW_EMBEDDING=true

# -----------------------------------------------------------
# --------------------- Backend env ----------------------
# -----------------------------------------------------------

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/transdb
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=${JWT_SECRET:-OBYcCOxLMXYDJxwgeOAdASTDflOwKNVm}
JWT_ISSUER=ft-transcendence
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID:-}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET:-}
GITHUB_REDIRECT_URI=${GITHUB_REDIRECT_URI:-http://localhost:8000/api/users/oauth/github/callback}

# -----------------------------------------------------------
# --------------------- Prometheus env ----------------------
# -----------------------------------------------------------

DS_PROMETHEUS=prometheus

# -----------------------------------------------------------
# --------------------- Postgres env ----------------------
# -----------------------------------------------------------

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=transdb
PGHOST=postgres
PGPORT=5432

# -----------------------------------------------------------
# ------------------------ Mongodb --------------------------
# -----------------------------------------------------------

MONGO_ROOT_PASSWORD=admin
MONGO_ROOT_USER=admin



# -----------------------------------------------------------
# -------------------- Owasp/Modsecutiry --------------------
# -----------------------------------------------------------

MODSEC_RULE_ENGINE=DetectionOnly
PARANOIA=1


