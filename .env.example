# ==============================================================================
#                      FT_TRANSCENDENCE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API GATEWAY & WAF (NGINX / MODSECURITY)
# ------------------------------------------------------------------------------
# ModSecurity engine mode: 'On' (blocking) or 'DetectionOnly' (logging only)
MODSEC_RULE_ENGINE=DetectionOnly
# OWASP Core Rule Set paranoia level (1 = standard, 2-4 = strict)
PARANOIA=1
BLOCKING_PARANOIA=1
#MODSEC_RULE_ENGINE=on


# ------------------------------------------------------------------------------
# 2. DATABASES
# ------------------------------------------------------------------------------
# --- PostgreSQL Container Init (used by the postgres container on startup) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=transdb

# --- PostgreSQL Client / libpq (used by psql inside docker-exporter) ---
PGHOST=postgres
PGPORT=5432
PGUSER=admin
PGPASSWORD=admin
PGDATABASE=transdb




# ------------------------------------------------------------------------------
# 3. BACKEND MICROSERVICES
# ------------------------------------------------------------------------------
# --- Spring Database Connectivity ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/transdb
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin

# --- Org Database Connectivity ---
ORG_DATASOURCE_URL=jdbc:postgresql://postgres:5432/org_service_db
ORG_DATASOURCE_USERNAME=admin
ORG_DATASOURCE_PASSWORD=admin

# --- JWT Authentication ---
JWT_SECRET=OBYcCOxLMXYDJxwgeOAdASTDflOwKNVm
JWT_ISSUER=ft-transcendence

# --- GitHub OAuth Configuration ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/users/oauth/github/callback



# Root account: created by the mongodb container on its first start only
# (changing it later needs: docker volume rm mongo_data).
MONGO_INITDB_ROOT_USERNAME=rooted
MONGO_INITDB_ROOT_PASSWORD=rooted123

# chat-service connection (may reuse the root account for now)
CHAT_MONGO_DB=chatdb
CHAT_MONGO_USER=rooted
CHAT_MONGO_PASSWORD=rooted123
CHAT_MONGO_AUTH_DB=admin
# ------------------------------------------------------------------------------
# 4. MONITORING & OBSERVABILITY
# ------------------------------------------------------------------------------
# --- Prometheus ---
DS_PROMETHEUS=prometheus

# --- Grafana Admin Credentials & Server ---
GF_SERVER_ROOT_URL=https://localhost:8443/grafana/
GF_SECURITY_COOKIE_SECURE=true
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_PLUGINS_CHECK_FOR_UPDATES=false

# --- Grafana Authentication (Enforce Login) ---
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_SECURITY_ALLOW_EMBEDDING=true

# --- Status Page (Gatus) Authentication ---
STATUS_PAGE_USER=admin
STATUS_PAGE_PASSWORD=admin
STATUS_PAGE_PASSWORD_BCRYPT_BASE64=JDJ5JDEwJGlxSU1rRlFtOHdCaHNya3ZCdVY4ZmVmdmFqV29yejlvTzRWN0dtNkcwaUtYMXdQMTU0OVBH

MODSEC_RULE_ENGINE=DetectionOnly
PARANOIA=1
