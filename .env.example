# -----------------------------------------------------------
# --------------------- grafana env ----------------------
# -----------------------------------------------------------

GF_SERVER_ROOT_URL=http://localhost/grafana/
GF_SECURITY_ADMIN_USER=something
GF_SECURITY_ADMIN_PASSWORD=something
GF_USERS_ALLOW_SIGN_UP=false
GF_PLUGINS_CHECK_FOR_UPDATES=false

# -----------------------------------------------------------
# --------------------- Postgres env ----------------------
# -----------------------------------------------------------

POSTGRES_USER=something
POSTGRES_PASSWORD=something
POSTGRES_DB=transdb
PGHOST=postgres
PGPORT=5432
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=${POSTGRES_DB}

# -----------------------------------------------------------
# --------------------- Backend env ----------------------
# -----------------------------------------------------------

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/transdb
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=${JWT_SECRET:-OBYcCOxLMXYDJxwgeOAdASTDflOwKNVm}
JWT_ISSUER=ft-transcendence
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID:-}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET:-}
GITHUB_REDIRECT_URI=${GITHUB_REDIRECT_URI:-http://localhost:8000/api/users/oauth/github/callback}

# -----------------------------------------------------------
# --------------------- Prometheus env ----------------------
# -----------------------------------------------------------

DS_PROMETHEUS=prometheus

# -----------------------------------------------------------
# --------------------- General env ----------------------
# -----------------------------------------------------------

UID=102718 ("run (id -u) in terminal to get yours")