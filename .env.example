# Gateway hostname (without https:// or a port).
DOMAIN=localhost

# -----------------------------------------------------------
# --------------------- grafana env ----------------------
# -----------------------------------------------------------

GF_SERVER_ROOT_URL=http://localhost/grafana/
GF_SECURITY_ADMIN_USER=something
GF_SECURITY_ADMIN_PASSWORD=something
GF_SERVER_ROOT_URL=https://localhost:8443/grafana/
GF_SECURITY_COOKIE_SECURE=true
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_PLUGINS_CHECK_FOR_UPDATES=false
# Enable Anonymous Access
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_NAME=Main Org.
# Set role: 'Admin' gives full UI control, 'Editor' lets you edit panels, 'Viewer' is read-only
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin

# Optional: Hide the login button/form completely from the UI
GF_AUTH_DISABLE_LOGIN_FORM=true
# Disable anonymous access (require authentication)
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_SECURITY_ALLOW_EMBEDDING=true

# -----------------------------------------------------------
# --------------------- Postgres env ----------------------
# -----------------------------------------------------------

# --- Identity PostgreSQL ---
IDENTITY_POSTGRES_HOST=identity-service_postgres
IDENTITY_POSTGRES_PORT=5432
IDENTITY_POSTGRES_USER='admin'
IDENTITY_POSTGRES_PASSWORD='admin'
IDENTITY_POSTGRES_DB='transdb'

# --- Organization PostgreSQL ---
ORG_POSTGRES_HOST=org-service_postgres
ORG_POSTGRES_PORT=5432
ORG_POSTGRES_USER='admin'
ORG_POSTGRES_PASSWORD='admin'
ORG_POSTGRES_DB='org_service_db'

# -----------------------------------------------------------
# --------------------- Backend env ----------------------
# -----------------------------------------------------------

ORG_DATASOURCE_URL='jdbc:postgresql://org-service_postgres:5432/org_service_db'
JWT_SECRET=${JWT_SECRET:-OBYcCOxLMXYDJxwgeOAdASTDflOwKNVm}
JWT_ISSUER=ft-transcendence
GITHUB_CLIENT_ID=${GITHUB_CLIENT_ID:-}
GITHUB_CLIENT_SECRET=${GITHUB_CLIENT_SECRET:-}
GITHUB_REDIRECT_URI=${GITHUB_REDIRECT_URI:-http://localhost:8000/api/users/oauth/github/callback}

# -----------------------------------------------------------
# --------------------- Prometheus env ----------------------
# -----------------------------------------------------------

DS_PROMETHEUS=prometheus

# -----------------------------------------------------------
# ------------------------ Mongodb --------------------------
# -----------------------------------------------------------

# MONGO_ROOT_PASSWORD=
# MONGO_ROOT_USER=
MONGO_INITDB_ROOT_USERNAME=rooted
MONGO_INITDB_ROOT_PASSWORD=rooted123

CHAT_MONGO_DB=chatdb
CHAT_MONGO_USER=rooted
CHAT_MONGO_PASSWORD=rooted123
CHAT_MONGO_AUTH_DB=admin

# --- Alertmanager Discord notifications ---
DISCORD_WEBHOOK_URL=


# -----------------------------------------------------------
# -------------------- Owasp/Modsecutiry --------------------
# -----------------------------------------------------------

MODSEC_RULE_ENGINE=DetectionOnly
PARANOIA=1

# Identity service / Prisma
DATABASE_URL="postgresql://${IDENTITY_POSTGRES_USER}:${IDENTITY_POSTGRES_PASSWORD}@${IDENTITY_POSTGRES_HOST}:${IDENTITY_POSTGRES_PORT}/${IDENTITY_POSTGRES_DB}?schema=public"
IDENTITY_HTTP_PORT=8083
IDENTITY_GRPC_PORT=9090
AVATAR_DIR=/tmp/identity-avatars

# -----------------------------------------------------------
# ---------------------- Object storage ---------------------
# -----------------------------------------------------------

R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_ACCOUNT_ID=...
R2_BUCKET=transcendence