generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  username        String       @unique(map: "uk_users_username") @db.VarChar(32)
  email           String       @unique(map: "uk_users_email")
  passwordHash    String?      @map("password_hash") @db.VarChar(100)
  displayName     String       @map("display_name") @db.VarChar(80)
  bio             String?      @db.VarChar(280)
  avatarUrl       String?      @map("avatar_url")
  authProvider    String       @default("LOCAL") @map("auth_provider")
  oauthProviderId String?      @map("oauth_provider_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")

  @@unique([authProvider, oauthProviderId], map: "uk_users_oauth")
  @@map("users")
}

model RefreshToken {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  tokenHash   String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at")
  revoked     Boolean       @default(false)
  replacedBy  String?       @unique @map("replaced_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  replacement RefreshToken? @relation("RefreshTokenRotation", fields: [replacedBy], references: [id], onDelete: SetNull)
  replaces    RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  pairKey     String           @unique(map: "uk_friendships_pair") @map("pair_key") @db.VarChar(73)
  status      String           @default("PENDING")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status], map: "idx_friendships_requester_status")
  @@index([addresseeId, status], map: "idx_friendships_addressee_status")
  @@map("friendships")
}
